# 이 파일을 ".env" 로 복사해서 값을 채워주세요. (로컬 실행용)
# Vercel 에 배포할 때는 같은 이름의 값을 Vercel 프로젝트의 Environment Variables 에 입력합니다. (DEPLOY.md 참고)

PORT=3000

# 가입 코드 (설정하면 이 코드를 아는 사람만 가입 가능. 비워두면 누구나 가입 → 공개 배포 시에는 꼭 설정)
JOIN_CODE=

# ───── 데이터베이스 (배포 시 필수 / 로컬에서는 비워두면 data/calendar.db 파일 사용) ─────
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ───── 첨부파일 저장소 (Vercel Blob 을 연결하면 자동으로 들어옴 / 로컬에서는 비워둠) ─────
BLOB_READ_WRITE_TOKEN=

# ───── 주기 작업 호출 암호 (배포 시 필수): /api/cron/tick 을 부를 때 "Authorization: Bearer 이 값" 으로 보냄 ─────
CRON_SECRET=

# ───── 시간대 (분 단위, 한국 = 540). 한국에서 쓰면 비워둠 ─────
APP_TZ_OFFSET_MIN=

# ───── 메일 발송(SMTP) 설정 (비워두면 메일은 발송되지 않고 콘솔에만 기록) ─────
# 예) Gmail: smtp.gmail.com / 587 / 앱 비밀번호 사용
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=업무캘린더 <your@email.com>
